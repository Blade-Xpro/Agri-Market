<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site.master.cs"
    Inherits="SiteMaster" %>

<!DOCTYPE html>

<html lang="en">

<head runat="server">

    <meta charset="utf-8" />

    <meta name="viewport"
        content="width=device-width, initial-scale=1.0" />

    <title>Agri Market</title>

    <!-- Fonts -->
    <link rel="preconnect"
        href="https://fonts.googleapis.com" />

    <link rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin="anonymous" />

    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&amp;family=Raleway:wght@600;800&amp;display=swap"
        rel="stylesheet" />

    <!-- Icons -->
    <link rel="stylesheet"
        href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css"
        rel="stylesheet" />

    <!-- Libraries -->
    <link href="lib/lightbox/css/lightbox.min.css"
        rel="stylesheet" />

    <link href="lib/owlcarousel/assets/owl.carousel.min.css"
        rel="stylesheet" />

    <!-- Bootstrap -->
    <link href="css/bootstrap.min.css"
        rel="stylesheet" />

    <!-- Existing stylesheet -->
    <link href="css/style.css"
        rel="stylesheet" />

    <!-- Child page head content -->
    <asp:ContentPlaceHolder
        ID="HeadContent"
        runat="server" />

</head>


<body>

    <form id="form1" runat="server">


        <!-- =========================
             LOADING SPINNER
             ========================= -->

        <div id="spinner"
            class="show w-100 vh-100 bg-white position-fixed translate-middle top-50 start-50 d-flex align-items-center justify-content-center">

            <div class="spinner-grow text-primary"
                role="status">
            </div>

        </div>


        <!-- =========================
             HEADER
             ========================= -->

        <div class="container-fluid fixed-top">



            <!-- Main navigation -->

            <div class="container px-0">

                <nav class="navbar navbar-light bg-white navbar-expand-xl">


                    <!-- Logo -->

                    <a runat="server"
                        href="~/Home.aspx"
                        class="navbar-brand">

                        <h1 class="text-primary display-6">
                            Agri Market
                        </h1>

                    </a>


                    <!-- Mobile menu button -->

                    <button class="navbar-toggler py-2 px-3"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarCollapse"
                        aria-controls="navbarCollapse"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                        <span class="fa fa-bars text-primary"></span>

                    </button>


                    <!-- Navigation menu -->

                    <div class="collapse navbar-collapse bg-white"
                        id="navbarCollapse">

<div class="navbar-nav mx-auto">

    <a runat="server"
        href="~/Home.aspx"
        class="nav-item nav-link">
        Home
    </a>

    <a runat="server"
        href="~/AllProductsPage.aspx"
        class="nav-item nav-link">
        Products
    </a>

    <a runat="server"
        href="~/About.aspx"
        class="nav-item nav-link">
        About
    </a>

</div>

                        <!-- Right side controls -->

                        <div class="d-flex m-3 me-0">


                            <!-- Search -->

                            <button class="btn-search btn border border-secondary btn-md-square rounded-circle bg-white me-4"
                                type="button"
                                data-bs-toggle="modal"
                                data-bs-target="#searchModal">

                                <i class="fas fa-search text-primary"></i>

                            </button>


                          <!-- Shopping cart -->

<a runat="server"
    href="~/ShoppingCart.aspx"
    class="position-relative me-4 my-auto">

    <i class="fa fa-shopping-bag fa-2x"></i>

</a>


                           <!-- User -->

<a runat="server"
    href="~/LoginPage.aspx"
    class="my-auto">

    <i class="fas fa-user fa-2x"></i>

</a>

                        </div>

                    </div>

                </nav>

            </div>

        </div>


        <!-- =========================
             MAIN CONTENT
             ========================= -->

        <main class="main-content-wrapper">

            <asp:ContentPlaceHolder
                ID="MainContent"
                runat="server" />

        </main>


        <!-- =========================
             FOOTER
             ========================= -->

       <footer class="agri-footer">

    <div class="container py-5">

        <div class="row g-5">

            <!-- About -->

            <div class="col-lg-4 col-md-6">

                <h4 class="footer-brand">
                    Agri Market
                </h4>

                <p>
                    Fresh agricultural products
                    from local farmers to our customers.
                </p>

            </div>


            <!-- Quick Links -->

            <div class="col-lg-4 col-md-6">

                <h4>
                    Quick Links
                </h4>

                <a runat="server"
                    href="~/Home.aspx"
                    class="d-block">
                    Home
                </a>

                <a runat="server"
                    href="~/AllProductsPage.aspx"
                    class="d-block">
                    Products
                </a>

                <a runat="server"
                    href="~/About.aspx"
                    class="d-block">
                    About
                </a>

            </div>


            <!-- Customer -->

            <div class="col-lg-4 col-md-6">

                <h4>
                    Customer
                </h4>

                <a runat="server"
                    href="~/LoginPage.aspx"
                    class="d-block">
                    Login
                </a>

                <a runat="server"
                    href="~/ShoppingCart.aspx"
                    class="d-block">
                    Shopping Cart
                </a>

            </div>

        </div>

    </div>


    <div class="footer-bottom">

        <div class="container">

            <div class="text-center">

                &copy; 2026 Agri Market.
                All Rights Reserved.

            </div>

        </div>

    </div>

</footer>


        <!-- =========================
             BACK TO TOP
             ========================= -->

        <a href="#"
            class="btn btn-primary border-3 border-primary rounded-circle back-to-top">

            <i class="fa fa-arrow-up"></i>

        </a>

        <!-- =========================
     SEARCH MODAL
     ========================= -->

<div class="modal fade"
    id="searchModal"
    tabindex="-1"
    aria-hidden="true">

    <div class="modal-dialog modal-fullscreen">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Search Products
                </h5>

                <button type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Close">
                </button>

            </div>


            <div class="modal-body">

                <div class="input-group w-75 mx-auto">

                    <input id="searchBar"
                        runat="server"
                        type="text"
                        class="form-control p-3"
                        placeholder="Search for products..." />

                    <asp:Button
                        ID="btnSearch"
                        runat="server"
                        Text="Search"
                        CssClass="btn btn-primary px-4"
                        OnClick="btnSearch_Click" />

                </div>

            </div>

        </div>

    </div>

</div>

      


    </form>


    <!-- =========================
         JAVASCRIPT LIBRARIES
         ========================= -->

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js">
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="lib/easing/easing.min.js">
    </script>

    <script src="lib/waypoints/waypoints.min.js">
    </script>

    <script src="lib/lightbox/js/lightbox.min.js">
    </script>

    <script src="lib/owlcarousel/owl.carousel.min.js">
    </script>

    <script src="js/main.js">
    </script>


</body>

</html>